 from .tables import LIMITATION
 
 
+def chunk_evidence_units(chunks: list[Chunk], citations: list[Citation]) -> list[str]:
+    """Expose prose paragraphs independently without changing source identity or text."""
+    units = []
+    for chunk, citation in zip(chunks, citations, strict=True):
+        paragraphs = (
+            [chunk.text] if chunk.kind == "table" else re.split(r"\n[ \t]*\n", chunk.text)
+        )
+        units.extend(
+            f"[{citation.id}] {chunk.section} (p.{chunk.page_start})\n{paragraph}"
+            for paragraph in paragraphs
+            if paragraph
+        )
+    return units
+
